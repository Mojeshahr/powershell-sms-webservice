# کپی کنید به .env و مقادیر خودتان را بگذارید. فایل .env نباید کامیت شود.
#
# نمونه‌ها این مقادیر را از محیط می‌خوانند و خودشان این فایل را نمی‌خوانند.
# در پاورشل این‌طور واردشان کنید:
#
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#]' } | ForEach-Object {
#       $name, $value = $_ -split '=', 2
#       Set-Item -Path "env:$name" -Value $value
#   }
#   .\examples\v3\account-info.ps1
#
# یا ساده‌تر، فقط برای همین جلسه:
#
#   $env:PAYAM_RESAN_API_KEY = '123456-XXXXXXXXXXXXXXX'
#   $env:PAYAM_RESAN_SENDER  = '30004040'

# کلید اختصاصی حساب، از پنل کاربری پیام رسان.
# شش رقم شناسه کاربری، خط تیره، و بخش کلید که دست‌کم پانزده نویسه است.
PAYAM_RESAN_API_KEY=123456-XXXXXXXXXXXXXXX

# یکی از خطوط فعال حساب. با examples\v3\account-info.ps1 فهرستشان را ببینید.
PAYAM_RESAN_SENDER=30004040
